function(add_sanitizer_flags target_name)
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    if(ENABLE_ASAN)
      target_compile_options(${target_name} PRIVATE -fsanitize=address,undefined -g -fno-omit-frame-pointer)
      target_link_options(${target_name} PRIVATE -fsanitize=address,undefined)
    elseif(ENABLE_TSAN)
      target_compile_options(${target_name} PRIVATE -fsanitize=thread -g -fno-omit-frame-pointer)
      target_link_options(${target_name} PRIVATE -fsanitize=thread)
    endif()
  endif()
endfunction()
